POSTGRES_DB=security_system
POSTGRES_USER=security_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes-for-HS256
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Must match the timezone used by the original Python process for naive timestamps.
APP_TIME_ZONE=Asia/Qyzylorda
CORS_ORIGINS=http://localhost:3000
# Optional, only used when the users table is empty. No default credentials.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Put security_backup.backup here BEFORE the first start to restore into a new volume.
DATABASE_IMPORT_DIR=./databases/import
# Optional demo data, only for an empty database. Set profile to demo and choose a password.
SPRING_PROFILES_ACTIVE=default
DEMO_PASSWORD=
